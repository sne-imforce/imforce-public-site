NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Set only when the API is behind a known reverse proxy. Use the exact trusted hop count.
# TRUST_PROXY_HOPS=1

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Paystack secret key stays on the API server; never use a VITE_ prefix.
PAYSTACK_SECRET_KEY=sk_test_replace-with-your-test-secret-key
# Optional webhook signing secret from Paystack dashboard (whsec_...).
PAYSTACK_WEBHOOK_SECRET=
# Optional public callback URL; defaults to FRONTEND_ORIGIN/employers.
PAYSTACK_CALLBACK_URL=

# --- Intrusion detection / alarm ---
# HTTPS incoming-webhook URL (Slack, Microsoft Teams, or any JSON receiver) that
# receives an alert when a trap is triggered or an IP is blocked. Treat it as a secret.
SECURITY_ALERT_WEBHOOK_URL=
# Comma-separated IPs that are never auto-blocked (e.g. the IMFORCE office).
SECURITY_ALLOWLIST_IPS=
# Private/loopback IPs are never auto-blocked by default, so a misconfigured proxy
# cannot let one attacker block every user. Set true only in tests.
# SECURITY_BLOCK_PRIVATE_IPS=false

# --- Staff two-factor sign-in ---
# Staff must confirm a 6-digit authenticator-app code after their password
# (Supabase Auth MFA, TOTP). On by default. Set to false only for local
# development against a project without MFA; the API logs a warning when off.
# STAFF_MFA_REQUIRED=true

# --- Email to employers ("Request changes" update links) ---
# Leave SMTP_HOST empty, or set SMTP_HOST=log (prints emails to this console,
# development only), and NO email reaches the employer: staff are shown the
# private link to send themselves. To really email employers, fill in your mail
# provider's SMTP settings, e.g. Microsoft 365: smtp.office365.com port 587;
# Google Workspace: smtp.gmail.com port 587 (use an app password).
# Check the settings with: npm run email:test -- you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Secret: store in the host's secret manager in production.
SMTP_PASSWORD=
EMAIL_FROM="IMFORCE Talent Recruitment <admin@imforce.co.za>"
EMAIL_REPLY_TO=admin@imforce.co.za
# Website address used in links inside emails (defaults to the first FRONTEND_ORIGIN).
PUBLIC_SITE_URL=
